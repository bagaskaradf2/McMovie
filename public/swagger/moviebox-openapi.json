{
  "openapi": "3.0.3",
  "info": {
    "title": "MovieBox Pro / AOneRoom REST API",
    "description": "Spesifikasi Resmi OpenAPI / Swagger untuk integrasi MovieBox API v1.0. Menyediakan katalog lengkap Trending Drama, Trending Movies, Film Indonesia Terbaru di Netflix, Sinetron Indonesia, K-Drama, dan resolusi streaming video direct.",
    "version": "1.0.0",
    "contact": {
      "name": "McMovies Engineering",
      "url": "https://github.com/bagaskaradf2/McMovie"
    }
  },
  "servers": [
    {
      "url": "https://api.sansekai.my.id/api",
      "description": "Sansekai MovieBox Gateway Server"
    },
    {
      "url": "http://localhost:5174/api/moviebox",
      "description": "Local McMovies BFF Mock & Scraped Service"
    }
  ],
  "tags": [
    {
      "name": "Discovery",
      "description": "Endpoints untuk kurasi konten beranda, trending, dan rilis terbaru"
    },
    {
      "name": "Indonesian Content",
      "description": "Koleksi khusus Film Indonesia Netflix, Series & Sinetron Indonesia"
    },
    {
      "name": "Playback & Streaming",
      "description": "Resolusi URL stream video langsung, proxy video, dan download link"
    }
  ],
  "paths": {
    "/moviebox/homepage": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Ambil feed konten beranda MovieBox",
        "description": "Mengembalikan daftar kurasi utama gabungan Trending Drama, Trending Movies, dan Indonesian Netflix releases.",
        "responses": {
          "200": {
            "description": "Daftar konten beranda berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomepageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/trending-drama": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Ambil serial & drama trending (Trending Drama 🔥)",
        "description": "Mengembalikan daftar drama trending termasuk serial Indonesia, K-Drama, dan original Netflix/WeTV/Disney+.",
        "responses": {
          "200": {
            "description": "Daftar Trending Drama berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MovieBoxItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/trending-movies": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Ambil film bioskop trending (Trending Movies)",
        "description": "Mengembalikan film-film blockbuster terpopuler dengan lencana akses gratis dan resolusi 4K UHD.",
        "responses": {
          "200": {
            "description": "Daftar Trending Movies berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MovieBoxItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/indo-netflix": {
      "get": {
        "tags": ["Indonesian Content"],
        "summary": "Ambil Film & Series Indonesia Terbaru di Netflix",
        "description": "Koleksi khusus film bioskop Indonesia yang baru rilis atau tayang resmi di platform Netflix (The Shadow Strays, Kabut Berduri, Sekawan Limo, Agak Laen, Siksa Kubur, dll).",
        "responses": {
          "200": {
            "description": "Daftar film Indonesia Netflix berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MovieBoxItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/indo-series": {
      "get": {
        "tags": ["Indonesian Content"],
        "summary": "Ambil Series & Sinetron Indonesia Terpopuler",
        "description": "Koleksi sinetron hits harian (Terikat Janji, Terbaik Itu Kamu, Cinta Yasmin, Naik Ranjang) dan web series Indonesia (Vidio, WeTV, Netflix).",
        "responses": {
          "200": {
            "description": "Daftar sinetron & series Indonesia berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MovieBoxItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/search": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Cari judul film, drama, atau sinetron",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Kata kunci pencarian judul (contoh: The Blue Road, Agak Laen, Terikat Janji)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hasil pencarian",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MovieBoxItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/detail": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Detail lengkap tayangan MovieBox",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "ID unik tayangan MovieBox (contoh: mb_td_1 atau ID numerik)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Informasi detail tayangan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieBoxItem"
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/get-download-url": {
      "get": {
        "tags": ["Playback & Streaming"],
        "summary": "Dapatkan link unduhan berkas video",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL unduhan video langsung",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "download_url": { "type": "string", "format": "uri" },
                    "quality": { "type": "string", "example": "1080p" },
                    "size": { "type": "string", "example": "1.4 GB" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/moviebox/proxy-video": {
      "get": {
        "tags": ["Playback & Streaming"],
        "summary": "Proxy video streaming untuk melewati proteksi CORS",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "URL CDN mentah yang dienkripsi atau diproxy",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream biner video MP4 / HLS m3u8"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MovieBoxItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "mb_td_2" },
          "tmdbId": { "type": "integer", "example": 242095 },
          "title": { "type": "string", "example": "The Blue Road" },
          "original_title": { "type": "string", "example": "The Blue Road" },
          "poster": { "type": "string", "format": "uri" },
          "backdrop": { "type": "string", "format": "uri" },
          "rating": { "type": "number", "format": "float", "example": 8.9 },
          "year": { "type": "string", "example": "2024" },
          "type": { "type": "string", "enum": ["movie", "series"], "example": "series" },
          "category": { "type": "string", "example": "Crime / Action / Thriller" },
          "platform": { "type": "string", "example": "Netflix" },
          "badge": { "type": "string", "example": "Netflix" },
          "synopsis": { "type": "string" },
          "duration": { "type": "string", "example": "2h 15m" },
          "episodes": { "type": "integer", "example": 8 },
          "seasons": { "type": "integer", "example": 1 }
        }
      },
      "HomepageResponse": {
        "type": "object",
        "properties": {
          "trending_drama": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MovieBoxItem" }
          },
          "trending_movies": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MovieBoxItem" }
          },
          "indo_netflix": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MovieBoxItem" }
          },
          "sinetron_series": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MovieBoxItem" }
          }
        }
      }
    }
  }
}